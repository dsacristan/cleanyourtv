<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Starting the player by explicit component needs no visibility, but the install script also asks it whether
         the package is there before wiring anything. -->
    <queries>
        <package android:name="com.purple.iptv.smart.player" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name">

        <!-- The tile (and the key target): opens the player's Favoritos screen and leaves. No display, no history:
             whoever pressed it should land in the player, not on a blank frame of this app. -->
        <activity
            android:name=".OpenFavouritesActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Watches for the remote's key and clicks Favoritos inside the player: only an accessibility service can
             read another app's screen or press its buttons, and the key has to be taken before the system's own
             global-key handler opens the store listing. -->
        <service
            android:name=".FavKeyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fav_service" />
        </service>
    </application>
</manifest>
